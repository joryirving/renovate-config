{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  mise: {
    enabled: true,
    managerFilePatterns: ["/(^|/)\\.mise/config\\.toml$/"],
  },
  packageRules: [
    {
      description: "Keep mise.lock up to date",
      matchManagers: ["mise"],
      lockFileMaintenance: {
        enabled: true,
      },
    },
  ],
}
