{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  mise: {
    enabled: true,
    managerFilePatterns: ["/(^|/)\\.mise/config\\.toml$/"],
  },
  packageRules: [
    {
      description: "Keep mise.lock up to date",
      matchManagers: ["mise"],
      lockFileMaintenance: {
        enabled: true,
      },
      // npm-backed mise tools (e.g. oxfmt) can only be locked once their node is
      // installed. The renovate operator image has no usable node for mise, so it
      // silently drops them from mise.lock and `mise install --locked` then fails on
      // every PR. Run `mise install` (installs the config-pinned node) before
      // `mise lock` so the regenerated lock is complete. NOTE: Renovate runs
      // post-upgrade task commands without a shell, so `&&` chaining is parsed as
      // mise tool names ("&&@latest", "mise@latest", "lock@latest"). Keep the
      // commands as separate entries, and allow each of `mise install` and
      // `mise lock` individually in allowedCommands (RENOVATE_ALLOWED_COMMANDS).
      postUpgradeTasks: {
        commands: ["mise install", "mise lock"],
        fileFilters: ["**/mise.lock"],
        executionMode: "branch",
      },
    },
  ],
}
